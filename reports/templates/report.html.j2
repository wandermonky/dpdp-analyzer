<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  @page { size: A4; margin: 2cm; }
  body { font-family: Arial, sans-serif; color: #1a1a1a; font-size: 11pt; }
  h1 { font-size: 22pt; margin-bottom: 0; color: #14213d; }
  h2 { font-size: 14pt; color: #14213d; margin-top: 28px; }
  .meta { color: #666; margin-top: 4px; }
  .score-box { margin: 24px 0; padding: 18px; border-radius: 8px; border: 2px solid #333; border-left: 10px solid #333; text-align: center; }
  .score-box .value { font-size: 40pt; font-weight: bold; }
  .score-good { border-color: #1e7d34; }
  .score-good .value { color: #1e7d34; }
  .score-warn { border-color: #cca300; }
  .score-warn .value { color: #a67c00; }
  .score-bad { border-color: #b30000; }
  .score-bad .value { color: #b30000; }
  table { width: 100%; border-collapse: collapse; margin: 12px 0 24px; }
  th, td { border: 1px solid #ddd; padding: 6px 8px; text-align: left; font-size: 10pt; }
  th { background: #14213d; color: #fff; }
  tr:nth-child(even) { background: #f7f7f9; }
  .bar-track { background: #eee; width: 100%; height: 10px; border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 10px; }
  .bar-good { background: #1e7d34; }
  .bar-warn { background: #cca300; }
  .bar-bad { background: #b30000; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 3px; color: #fff; font-size: 9pt; font-weight: bold; }
  .badge-critical { background: #b30000; }
  .badge-high { background: #e07b00; }
  .badge-medium { background: #cca300; }
  .badge-low { background: #6b6b6b; }
  footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #999; font-size: 8.5pt; color: #444; }
</style>
</head>
<body>

<h1>{{ title }}</h1>
<div class="meta">Generated on {{ generated_on }}</div>

<div class="score-box score-{{ score_class }}">
  <div class="value">{{ overall_score }}</div>
  <div>Readiness score (0-100)</div>
</div>

<h2>Category breakdown</h2>
<table>
  <tr><th>Category</th><th>Findings</th><th>Failed</th><th>Score</th><th></th></tr>
  {% for cat in categories %}
  <tr>
    <td>{{ cat.category }}</td>
    <td>{{ cat.total }}</td>
    <td>{{ cat.failed }}</td>
    <td>{{ cat.score }}</td>
    <td><div class="bar-track"><div class="bar-fill bar-{{ cat.score_class }}" style="width: {{ cat.score }}%;"></div></div></td>
  </tr>
  {% endfor %}
</table>

<h2>Remediation checklist</h2>
{% if remediation %}
<table>
  <tr><th>Severity</th><th>Rule</th><th>Category</th><th>Section</th><th>Rows affected</th><th>Issue</th><th>Remediation</th></tr>
  {% for item in remediation %}
  <tr>
    <td><span class="badge badge-{{ item.severity }}">{{ item.severity|upper }}</span></td>
    <td>{{ item.rule_id }}</td>
    <td>{{ item.category }}</td>
    <td>{{ item.section_ref }}</td>
    <td>{{ item.affected_rows }}</td>
    <td>{{ item.description }}</td>
    <td>{{ item.remediation }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>No failed findings — nothing to remediate.</p>
{% endif %}

<footer>{{ disclaimer }}</footer>

</body>
</html>
